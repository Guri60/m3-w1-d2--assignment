doctype html
html
  head
    title HTTP Password Generator

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(rel='stylesheet', href='/style.css')

  body.bg-light

    .container.mt-5

      .card.shadow.p-4.mx-auto(style='max-width: 600px')

        h1.text-center.mb-4 HTTP Password Generator

        form(action='/generate' method='POST')

          .mb-3
            label.form-label Username
            input.form-control(
              type='text'
              name='username'
              required
            )

          .mb-3
            label.form-label Password
            input.form-control(
              type='password'
              name='password'
              required
            )

          .d-grid.gap-2

            button.btn.btn-primary(
              type='submit'
            )
              | Generate Encrypted Password

            if encryptedPassword

              textarea.form-control.mt-3(
                rows='4'
                readonly
              )= encryptedPassword

              button.btn.btn-success.mt-3(
                type='button'
                onclick='downloadFile()'
              )
                | Create .htpasswd

              button.btn.btn-danger.mt-2(
                type='reset'
              )
                | Clear

    script.
      function downloadFile() {

          const text = document.querySelector('textarea').value;

          const blob = new Blob([text], { type: 'text/plain' });

          const link = document.createElement('a');

          link.href = window.URL.createObjectURL(blob);

          link.download = '.htpasswd';

          link.click();
      }