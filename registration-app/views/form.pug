doctype html
html
  head
    title My Amazing App

    // Bootstrap CDN
    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(rel='stylesheet', href='/style.css')

  body.bg-light

    .container.mt-5

      .card.shadow.p-4.mx-auto(style='max-width: 500px')

        h1.text-center.mb-4 My Amazing App

        if errors.length > 0
          .alert.alert-danger
            ul.mb-0
              each error in errors
                li= error.msg

        form(action='/submit' method='POST')

          .mb-3
            label.form-label Name
            input.form-control(
              type='text'
              name='name'
              value=oldData.name || ''
            )

          .mb-3
            label.form-label Email
            input.form-control(
              type='email'
              name='email'
              value=oldData.email || ''
            )

          .mb-3
            label.form-label Password
            input.form-control(
              type='password'
              name='password'
            )

          button.btn.btn-primary.w-100(type='submit')
            | Submit